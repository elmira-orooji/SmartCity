            </AnchorPane>
            <AnchorPane fx:id="Reset_password_page" layoutX="304.0" prefHeight="404.0" prefWidth="306.0" styleClass="purple-background" stylesheets="@forgetpassword.css">
               <children>
                  <Label layoutX="92.0" layoutY="35.0" text="Reset Password " textFill="WHITE">
